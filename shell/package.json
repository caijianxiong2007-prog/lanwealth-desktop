{
  "name": "bayze-desktop",
  "productName": "Bayze",
  "version": "1.3.0",
  "description": "Bayze (白泽) AI Chat — Desktop App",
  "main": "main.js",
  "author": "LanWealth",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac dmg --win nsis",
    "test": "node --test",
    "probe:egress": "node scripts/egress-probe.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.lanwealth.bayze",
    "productName": "Bayze",
    "copyright": "Copyright © 2026 LanWealth",
    "afterPack": "build/fuses.js",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "dmg": {
      "title": "Bayze",
      "backgroundColor": "#0a0a0a"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "egress-gate.js",
      "assets/**"
    ]
  }
}
